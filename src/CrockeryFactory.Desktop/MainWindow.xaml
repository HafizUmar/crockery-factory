<Window x:Class="CrockeryFactory.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CrockeryFactory.Desktop.Views"
        Title="Crockery Factory"
        Height="720" Width="1180"
        WindowStartupLocation="CenterScreen">

    <DockPanel>

        <Border DockPanel.Dock="Top" Background="#2E3B44" Padding="20,14">
            <StackPanel>
                <TextBlock Text="Crockery Factory" FontSize="19" Foreground="White" />
                <TextBlock Text="Catalogue and shop floor" Foreground="#A9BCC6" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <TabControl Margin="16" Padding="0">
            <TabItem Header="Products" Background="#1F6FEB">
                <views:ProductsView DataContext="{Binding Products}" />
            </TabItem>
            <TabItem Header="Production" Background="#C0392B">
                <views:ProductionView DataContext="{Binding Production}" />
            </TabItem>
        </TabControl>

    </DockPanel>
</Window>
